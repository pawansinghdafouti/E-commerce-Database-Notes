NNER JOIN → Matching rows only    (if we only write join it indicate inner join by defalult )

LEFT JOIN → All left rows and matching rows from right

RIGHT JOIN → All right rows and matching rows from left

CROSS JOIN → Every combination

SELF JOIN → Same table joined to itself

ON → Specifies the matching condition

AS → Gives a table or column an alias(or custom name)



-- Inner join
select * from 
products as p
inner join categories  as c on p.category_id = c.category_id;

-- left join

select * from 
products as p
left join categories as c on p.category_id = c.category_id;

select * from 
products as p
Right join categories as c on p.category_id = c.category_id;

-- full outer join we use union to join two tabel from left and right 
select * from 
products as p
left join categories as c on p.category_id = c.category_id
union
select * from 
products as p
Right join categories as c on p.category_id = c.category_id;

-- cross join 
select * from customers 
cross join orders;

-- Give me all customer who did not place any orders ?
select  c.first_name,c.email, c.phone,o.order_id,o.status
from 
customers as c 
left join orders as o on c.customer_id = o.customer_id
where o.order_id is null;


-- give me orders whose payments are failed ?
select p.order_id,p.status,p.payment_date,o.status
 from payments as p
left join orders as o on p. order_id = o. order_id 
where p.status = "failed" ;

-- give me orders which are not paid
select * from orders as o
left join payments as p on p. order_id = o. order_id
where p.payment_id is  null;

-- Give me information about all orders that are there in the db
-- include info about orders_items, products, customers and 
-- category the product belongs to

SELECT 
    o.order_id,
    o.status,
    oi.product_id,
    oi.unit_price,
    p.product_name,
    p.price,
    c.category_name,
    cu.first_name,
    cu.last_name
FROM orders as o
LEFT JOIN order_items as oi ON oi.order_id = o.order_id
LEFT JOIN products as p ON p.product_id = oi.product_id
LEFT JOIN categories as c ON c.category_id = p.category_id
LEFT JOIN customers as cu ON cu.customer_id = o.customer_id;
